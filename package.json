{
  "name": "useguardril",
  "version": "0.0.0",
  "description": "Monorepo workspace root: useguardril, a frontend-first authorization SDK (packages/*) + docs website (apps/website).",
  "license": "ISC",
  "author": {
    "name": "Sebastian Marat Urdanegui Bisalaya",
    "url": "https://www.sebastianurdanegui.com/"
  },
  "private": true,
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
    "dev": "pnpm --filter ./packages/core run dev",
    "typecheck": "pnpm --filter \"./packages/*\" run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm --filter \"./packages/*\" run test",
    "test:watch": "pnpm --filter ./packages/core run test:watch",
    "prepare": "husky"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "husky": "9.1.7"
  }
}
