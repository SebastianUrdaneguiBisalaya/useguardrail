{
  "name": "@useguardril/react",
  "version": "0.1.0",
  "description": "React adapter for @useguardril/core: provider, hooks and components with selective subscriptions.",
  "keywords": [
    "authorization",
    "rbac",
    "rebac",
    "abac",
    "permissions",
    "react",
    "hooks",
    "typescript",
    "esm",
    "cjs"
  ],
  "license": "ISC",
  "author": {
    "name": "Sebastian Marat Urdanegui Bisalaya",
    "url": "https://www.sebastianurdanegui.com/"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@useguardril/core": "workspace:^",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@useguardril/core": "workspace:*",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "8.5.1",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  }
}
