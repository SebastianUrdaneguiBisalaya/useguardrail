{
  "name": "@useguardrail/core",
  "version": "0.1.0",
  "description": "Framework-independent authorization engine (RBAC, ReBAC, ABAC) with a reactive store, with dual ESM/CJS support.",
  "keywords": [
    "authorization",
    "rbac",
    "rebac",
    "abac",
    "permissions",
    "typescript",
    "esm",
    "cjs"
  ],
  "license": "ISC",
  "author": {
    "name": "Sebastian Marat Urdanegui Bisalaya",
    "url": "https://www.sebastianurdanegui.com/"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastianUrdaneguiBisalaya/useguardrail.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/SebastianUrdaneguiBisalaya/useguardrail/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/SebastianUrdaneguiBisalaya/useguardrail/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "bench": "vitest bench --run",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.10.2",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  }
}
